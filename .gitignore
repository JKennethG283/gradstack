# Ignore everything at the top level by default
/*

# Track only the challenge track/task folders (and this file)
!/.gitignore
!/README.md
!/track-2-development
!/track-3-ai

# docs/ is intentionally NOT ignored so local AI tooling (Cursor/Codex) can read it.
# It is deliberately left UNTRACKED so it never gets pushed to GitHub.
# Do NOT `git add docs/` or commit anything under docs/.
!/docs

# Python cache generated by local validation
__pycache__/
*.pyc

# Local API keys
.env
