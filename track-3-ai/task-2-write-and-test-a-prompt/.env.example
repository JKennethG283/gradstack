# Required for both Gemini runs. Either variable is accepted.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Free-tier-friendly Gemini comparison models.
# Change these if Google AI Studio shows a different model ID for your account.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_FLASH_DISPLAY_NAME=Gemini Flash

GEMINI_FLASH_LITE_MODEL=gemini-flash-lite-latest
GEMINI_FLASH_LITE_DISPLAY_NAME=Gemini Flash-Lite
